{
  "name": "framework-adoption-eval",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "evals": "vitest run --config vitest.evals.config.ts",
