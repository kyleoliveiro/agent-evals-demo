    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
